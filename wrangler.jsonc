{
  // Cloudflare Workers 配置
  // 部署前执行 `npx wrangler kv namespace create WALLS`,
  // 把输出的 id 填到下面 kv_namespaces[].id
  "name": "wallpaper",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "WALLS",
      "id": "dd8fb1956ca14759a8c9d7ce5a3d6ca7"
    }
  ],
  "triggers": {
    // 北京时间 00:00 / 02:30 各跑一次,第二次兜底
    "crons": ["0 16 * * *", "30 18 * * *"]
  }
}
